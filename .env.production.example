# Public hostname. Point its DNS A/AAAA record to the server before starting Caddy.
DOMAIN=cinema.example.com

# Generate unique values on the server; never commit .env.production.
DJANGO_SECRET_KEY=replace-me-with-output-of-openssl-rand-base64-48-before-deploy
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

POSTGRES_DB=kinomir
POSTGRES_USER=kinomir
POSTGRES_HOST=db
POSTGRES_PORT=5432

DJANGO_ALLOWED_HOSTS=cinema.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://cinema.example.com
DJANGO_CORS_ALLOWED_ORIGINS=https://cinema.example.com
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_LOG_LEVEL=INFO
REDIS_URL=redis://redis:6379/1
DRF_THROTTLE_ANON_RATE=60/min
DRF_THROTTLE_USER_RATE=240/min
DRF_THROTTLE_LOGIN_RATE=5/min
DRF_THROTTLE_REGISTER_RATE=3/hour
DRF_THROTTLE_COMMENTS_RATE=10/min
DRF_NUM_PROXIES=2

DJANGO_SEED_DEMO=false
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=60

# Error monitoring. Create a Django project in Sentry and copy its DSN.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=kinomir@1.0.0
SENTRY_TRACES_SAMPLE_RATE=0.05

# Alertmanager-compatible HTTPS webhook. Keep it secret.
ALERT_WEBHOOK_URL=https://alerts.example.com/prometheus-webhook
PROMETHEUS_RETENTION=15d

# Encrypted off-site backups (Amazon S3, Backblaze B2 S3, Wasabi or MinIO).
RESTIC_REPOSITORY=s3:https://s3.example.com/kinomir-backups
RESTIC_PASSWORD=replace-with-a-separate-long-random-restic-password
AWS_ACCESS_KEY_ID=replace-with-backup-only-access-key
AWS_SECRET_ACCESS_KEY=replace-with-backup-only-secret-key
AWS_DEFAULT_REGION=us-east-1
BACKUP_CRON=0 3 * * *
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=12
BACKUP_CHECK_SUBSET=5%
BACKUP_HOST=kinomir-production
BACKUP_RUN_ON_START=false
